#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8

  keyboard:
    layout: us

  ssh:
    install-server: true
    allow-pw: true
    disable_root: false

  storage:
    swap:
      size: 0
    layout:
      name: lvm

  packages:
    - qemu-guest-agent
    - sudo
    - ca-certificates
    - openssh-server
    - netplan.io

  network:
    version: 2
    ethernets:
      default:
        match:
          name: "e*"
        dhcp4: true
  user-data:
    users:
      - name: ubuntu
        gecos: Ubuntu
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
        lock_passwd: false
        passwd: "$6$leandrosaltfixo$spdJDrdWMycINQP5Phvysm0WtcwvCdOspJK7miEZqEUiei3hl1MPNZAgyeSXfBItwWmzdbBc8.tHXVCFsGz10."

  late-commands:
    - curtin in-target --target=/target -- sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
    - curtin in-target --target=/target -- sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
    - curtin in-target --target=/target -- mkdir -p /root/.ssh
    - curtin in-target --target=/target -- bash -c "echo 'ssh-rsa  root@node01' > /root/.ssh/authorized_keys"
    - curtin in-target --target=/target -- chmod 700 /root/.ssh
    - curtin in-target --target=/target -- chmod 600 /root/.ssh/authorized_keys
    - curtin in-target --target=/target -- ssh-keygen -A
